---
# Copy to secrets.yml (gitignored) and fill in. The coarse tile-access key for
# tiles.appmire.be — shared with gpsinfo (deploy/ansible/secrets.yml) and baked
# into clients. Consumed by the web container's config.js.
tiles_api_key: ""

# EUMETSAT Data Store credentials for the MTG collectors (mtg_li / mtg_l2).
eumetsat_consumer_key: ""
eumetsat_consumer_secret: ""

# Note: the ERA5 collector (era5 role) needs NO credentials — it reads the public
# ARCO-ERA5 Zarr anonymously from GCS.
