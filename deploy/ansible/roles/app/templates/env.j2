# Managed by Ansible (deploy/ansible/group_vars/all.yml). Do not edit on the box.
{% for k, v in pluvio_env.items() %}
{{ k }}={{ v }}
{% endfor %}

# Web PWA runtime config — read by compose for the `web` service's environment,
# then injected into config.js at container startup.
VITE_API_BASE={{ pluvio_web_api_base }}
VITE_TILES_URL={{ pluvio_web_tiles_url }}
VITE_TILES_KEY={{ tiles_api_key | default('') }}
