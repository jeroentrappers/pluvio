# Local dev config (Vite reads .env). In production these are injected at
# container startup via config.js (see docker-entrypoint.d/40-pluvio-config.sh).

# Pluvio forecast API origin.
VITE_API_BASE=https://pluvio.appmire.be

# Shared self-hosted vector tile server (MapLibre + PMTiles).
VITE_TILES_URL=https://tiles.appmire.be
# Coarse access key gating tiles.appmire.be (ships in the client; abuse bounded
# by nginx limit_req). Lives in gpsinfo deploy/ansible/secrets.yml.
VITE_TILES_KEY=
